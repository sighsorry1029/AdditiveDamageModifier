<Project>
    <PropertyGroup>
        <!-- Override with /p:GamePath=... when Valheim is installed elsewhere. -->
        <GamePath Condition="'$(GamePath)' == '' AND Exists('C:\Program Files (x86)\Steam\steamapps\common\Valheim')">C:\Program Files (x86)\Steam\steamapps\common\Valheim</GamePath>
        <!--<CopyOutputDLLPath2>$(GamePath)\BepInEx\plugins</CopyOutputDLLPath2>-->
        <!--<CopyOutputDLLPath3>$(GamePath)\BepInEx\plugins</CopyOutputDLLPath3>-->
    </PropertyGroup>
</Project>
